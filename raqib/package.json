{
  "name": "raqib",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Raqib - a light, offline-first reverse-engineering observatory (MCP server + CLI + local console).",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "raqib": "dist/raqib.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --tests && node --test \"dist/test/*.test.mjs\"",
    "bench": "node scripts/build.mjs && node bench/bench.mjs"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
