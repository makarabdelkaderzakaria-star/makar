# NetRocket — optional cloud features (configuration sync, activation lookups).
# Copy to .env and fill in. `.env` is git-ignored and must never be committed.
#
# The publishable key is public by design: it is safe in a client binary *only*
# because every table it can reach is protected by row-level security. Never
# put the secret key here, in a release build, or anywhere a user can read it.
# NetRocket currently ships without cloud features; this file exists so that
# adding them does not start with a key committed by accident.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
